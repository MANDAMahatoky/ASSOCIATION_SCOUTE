            </a>
            <?php if ($stats['a_reparer'] > 0): ?>
            <a href="modules/materiel/liste.php?etat=à+réparer" class="stat-card warning">
                <div class="stat-value"><?= $stats['a_reparer'] ?></div>
                <div class="stat-label">Matériel à réparer</div>
            </a>
            <?php endif; ?>
